        <mxCell id="MXUQjWeKat6mIb6Z7VlJ-38" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Redis channel per video:&lt;/div&gt;&lt;div&gt;This helps us with fetching all comments for same videos from same partition&lt;/div&gt;&lt;div&gt;This will also help us maintain ordering&lt;/div&gt;&lt;div&gt;&lt;strong data-start=&quot;683&quot; data-end=&quot;700&quot;&gt;Redis Pub/Sub&lt;/strong&gt;&lt;br&gt;Channel: &lt;code data-start=&quot;714&quot; data-end=&quot;734&quot;&gt;comments:{videoId}&lt;/code&gt;&lt;br&gt;BroadcastService dynamically subscribes to channels for videos with active SSE clients.&lt;br&gt;MongoDB remains the source of truth; Redis is used for low-latency live delivery.&lt;/div&gt;" vertex="1">
