        </mxCell>
        <mxCell id="CtbqzY2CMxK35j-hzqa_-42" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="System flow:&lt;div&gt;User Search for Events -&amp;gt; gets list of events -&amp;gt; search for Event details and seats for a selected Event -&amp;gt; Select seats and book -&amp;gt; Booking checks the Seat if avialable block and go for payment -&amp;gt; async processing of the payment with webhook -&amp;gt; payment completed -&amp;gt; booking confirmed -&amp;gt; event updated&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="890" x="401.5" y="-50" as="geometry" />
        </mxCell>
        <mxCell id="CtbqzY2CMxK35j-hzqa_-43" edge="1" parent="1" source="CtbqzY2CMxK35j-hzqa_-5" style="endArrow=classic;startArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="CtbqzY2CMxK35j-hzqa_-13" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="670" y="400" as="sourcePoint" />
            <mxPoint x="720" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="CtbqzY2CMxK35j-hzqa_-44" connectable="0" parent="CtbqzY2CMxK35j-hzqa_-43" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="For Booking status&amp;nbsp;&lt;div&gt;Query through SSE&lt;/div&gt;" vertex="1">
          <mxGeometry relative="1" x="-0.0107" y="-2" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="CtbqzY2CMxK35j-hzqa_-47" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Search with Text , Location etc:&lt;div&gt;Our searching needs to based on text so a query to Postgres will not be efficient here. We can utilised the inverted indexing of Elasticsearch to handle this. The event updates can be published to elastic serach asynchronusly and we can leverate some CDC connecters that comes out of the box.&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="330" x="40" y="606" as="geometry" />
        </mxCell>
        <mxCell id="CtbqzY2CMxK35j-hzqa_-48" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Strong consistency in seat booking :&lt;div&gt;Redis will be used as a temporary coordinator of the seats. We lookup if the seat is available in redis then it will be blocked and book request fails. The record have TTL so it expires after sometime in case of drop in the flow. In case of simultaneously checking the Redis for non existent seat it creates entry with first request and second request fails.&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="330" x="401.5" y="606" as="geometry" />
        </mxCell>
        <mxCell id="CtbqzY2CMxK35j-hzqa_-49" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Hot Events:&lt;br&gt;The Hot events fetch will go through the redis to fasten up and save effort on search.&lt;br&gt;for booking we will enable the processing through booking queue and the flow can be controlled with back pressure.&lt;br&gt;We enable the confirmation with SSE to fetch booking status.&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="360" x="740" y="600" as="geometry" />
        </mxCell>
        <mxCell id="CtbqzY2CMxK35j-hzqa_-50" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Payments:&lt;br&gt;Usually the payments are docoupled but for this sytem we integrated with the booking service for simplicity. But the Payments will be done asynchronously and the update from payments will be done with the Webhook." vertex="1">
          <mxGeometry height="110" width="330" x="1110" y="590" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
