        <mxCell id="CtbqzY2CMxK35j-hzqa_-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;IRCTC&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Requirements:&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;User is able to see all the train between destination&lt;/li&gt;&lt;li&gt;User is able to check available seats&lt;/li&gt;&lt;li&gt;User is able to Select the seat&lt;/li&gt;&lt;li&gt;User is able to Book the Ticket by completing Payments&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;Out of Scope:&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Cancelation&lt;/li&gt;&lt;li&gt;Train Creation/ Scheduling new trains/ Changes&lt;/li&gt;&lt;li&gt;Multi berth types&lt;/li&gt;&lt;li&gt;Part journey booking&lt;/li&gt;&lt;li&gt;RAC Waiting list&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;NFRs:&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Zero double booking&lt;/li&gt;&lt;li&gt;Low latency for look up and selection&lt;/li&gt;&lt;li&gt;Highly available Look up service&lt;/li&gt;&lt;li&gt;read &amp;gt;&amp;gt; write&lt;/li&gt;&lt;li&gt;Handle popular Tatkal booking&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="370" width="370" x="40" y="-40" as="geometry" />
        </mxCell>
