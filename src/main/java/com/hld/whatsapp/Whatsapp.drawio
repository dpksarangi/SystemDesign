        <mxCell id="DpQjGeWfk7Bs1uR8Qe6S-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Real time Message interaction:&amp;nbsp;&lt;br&gt;The user sends a message and another user should be able to instantly receive the massage.&lt;br&gt;&lt;br&gt;For this realtime usage we need websockets and should always maintain a connection with the client and server&lt;br&gt;&lt;br&gt;We get the msg identify the connection and forward the msg to client again" vertex="1">
