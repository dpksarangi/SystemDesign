        <mxCell id="DpQjGeWfk7Bs1uR8Qe6S-35" parent="1" style="ellipse;whiteSpace=wrap;html=1;" value="Redis PUB-SUB&lt;br&gt;&amp;nbsp;shard with userid&lt;br&gt;message not stored&amp;nbsp;&lt;br&gt;to be fetched from&amp;nbsp;&lt;br&gt;UserChatStore" vertex="1">
          <mxGeometry height="100" width="130" x="340" y="180" as="geometry" />
        </mxCell>
        <mxCell id="DpQjGeWfk7Bs1uR8Qe6S-37" edge="1" parent="1" source="DpQjGeWfk7Bs1uR8Qe6S-4" style="endArrow=classic;startArrow=classic;html=1;rounded=0;exitX=0.45;exitY=-0.033;exitDx=0;exitDy=0;exitPerimeter=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="390" y="320" as="sourcePoint" />
            <mxPoint x="440" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DpQjGeWfk7Bs1uR8Qe6S-38" edge="1" parent="1" source="DpQjGeWfk7Bs1uR8Qe6S-3" style="endArrow=classic;startArrow=classic;html=1;rounded=0;exitX=1.014;exitY=0.791;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" target="DpQjGeWfk7Bs1uR8Qe6S-22" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="510" y="500" as="sourcePoint" />
            <mxPoint x="560" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DpQjGeWfk7Bs1uR8Qe6S-39" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Offline User Scenario&lt;br&gt;User sends message server not able to find the websocket- persist the message into UserChatStore with some TTL say 30 days. When user comes back online after establishing the connection publish all pending messages in userChatstore with undelivered status to the user.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;This also enables us to create a UserChatStore which can be leveraged with Redis pubsub to scal out direct message to hold billions of connections and robustness increased with persisted message in case of network or sockets disconnection.&lt;br&gt;this will enable us to enforce a ack based delivery reattempt of messages.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="210" x="800" y="600" as="geometry" />
        </mxCell>
        <mxCell id="DpQjGeWfk7Bs1uR8Qe6S-40" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;&quot;&gt;What is Redis PubSub Solving here&lt;br&gt;We have scaled chatservice now how do user1 message on server1 go to user2 whose connection is living in server2.&lt;br&gt;We need to store a mapping of user-server so that we can forward the message to users on other server.&lt;br&gt;&lt;br&gt;solution with each new connection user subscribes to its own message pub/sub and it will be only message id with message living in the userchatstore.&lt;br&gt;So the size of pubsub topics stay small and scaled to billions&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="210" x="1040" y="590" as="geometry" />
        </mxCell>
        <mxCell id="DpQjGeWfk7Bs1uR8Qe6S-41" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Server handles idempotency using message ID created by client&lt;br&gt;Client also ensures the idempotency of messages with message id" vertex="1">
          <mxGeometry height="60" width="210" x="690" y="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
