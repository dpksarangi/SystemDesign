        <mxCell id="QkF9t_r_pzvvDCB32Era-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;APIs:&lt;/span&gt;&lt;br&gt;&lt;ul&gt;&lt;li&gt;Curd profile (add update)&lt;/li&gt;&lt;li&gt;GetRecomdn(userid) -&amp;gt; {list of recomendation}&lt;/li&gt;&lt;li&gt;swipe(userid, recomId, yes/no) -&amp;gt; matched notif incase of match&lt;/li&gt;&lt;/ul&gt;" vertex="1">
