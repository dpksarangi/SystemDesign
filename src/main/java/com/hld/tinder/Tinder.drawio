        <mxCell id="QkF9t_r_pzvvDCB32Era-18" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Features:&lt;div&gt;&lt;ul&gt;&lt;li&gt;User is able to add/update profile prefs&lt;/li&gt;&lt;li&gt;User is able to see recommended matches&lt;/li&gt;&lt;li&gt;User is notified in case of two way match&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;NFR:&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Low latency for recommendation deck&lt;/li&gt;&lt;li&gt;real time &amp;lt;50ms for two way match detection&lt;/li&gt;&lt;li&gt;We quick update of recom deck in case of pref update of user&lt;/li&gt;&lt;li&gt;Availability of matches &amp;gt;over&amp;gt; realtime update of pref in case of recomended user pref update&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="310" x="-210" y="110" as="geometry" />
        </mxCell>
